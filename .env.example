# SMART ST Control Center Configuration

# Backend Service
HOST=127.0.0.1
PORT=8001
YOLO_MODEL_PATH=yolov8n.pt

# YOLO Person Detection Confidence Threshold (Backend-controlled)
# Range: 0.01 to 0.99. Default: 0.25 (25% confidence)
YOLO_CONFIDENCE_THRESHOLD=0.25

# Mismatch alert thresholds (backend-only)
# Minimum absolute passenger variance before an alert is created.
MISMATCH_THRESHOLD=2
# Variance at or above this value is classified as a high-severity alert.
HIGH_MISMATCH_THRESHOLD=4
# Active-trip dashboard tolerance in passengers. Falls back to MISMATCH_THRESHOLD.
MISMATCH_TOLERANCE=2

# Frontend Service
VITE_API_URL=http://127.0.0.1:8001
